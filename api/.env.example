# Runtime uses a restricted database role; require TLS to a remote PostgreSQL.
LEMONERGY_DATABASE_URL=postgresql://lemonergy_api:REPLACE_ME@localhost:5432/lemonergy_service?sslmode=require
LEMONERGY_CATALOG=api/catalog.json
# Operator shell only. Never put the owner/admin DSN in the running API container.
# LEMONERGY_ADMIN_DATABASE_URL=postgresql://OWNER:REPLACE_ME@localhost:5432/lemonergy_service?sslmode=require
