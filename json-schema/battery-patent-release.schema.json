{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lemonergy.com/schemas/battery-patent-release.v1.json",
  "title": "Battery patent release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_version", "taxonomy_version",
    "classifier_version", "source_snapshot", "ordered_record_hashes",
    "validation", "review_gate"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "release_version": {"type": "string", "minLength": 1},
    "taxonomy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "classifier_version": {"type": "string", "minLength": 1},
    "source_snapshot": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["retrieved_at", "terms_url"],
        "properties": {
          "retrieved_at": {"type": "string", "format": "date-time"},
          "terms_url": {"type": "string", "format": "uri"},
          "watermark": {"type": ["string", "null"]},
          "snapshot_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "ordered_record_hashes": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "uniqueItems": true
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "families", "duplicates", "invalid", "unclassified", "source_errors"],
      "properties": {
        "records": {"type": "integer", "minimum": 0},
        "families": {"type": "integer", "minimum": 0},
        "duplicates": {"type": "integer", "minimum": 0},
        "invalid": {"type": "integer", "minimum": 0},
        "unclassified": {"type": "integer", "minimum": 0},
        "source_errors": {"type": "integer", "minimum": 0}
      }
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sample_size", "sampling_seed", "reviewer"],
      "properties": {
        "state": {"enum": ["pending_review", "accepted", "rejected"]},
        "sample_size": {"type": "integer", "minimum": 0},
        "sampling_seed": {"type": "string", "minLength": 1},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
