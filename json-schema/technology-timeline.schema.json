{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Morshedvarzandeh/battery-data/json-schema/technology-timeline.schema.json",
  "title": "Reviewed manufacturer platform milestones; no implicit SKU release mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewed_at", "scope_note", "milestones"],
  "properties": {
    "schema_version": {"const": 1},
    "reviewed_at": {"type": "string", "format": "date"},
    "scope_note": {"type": "string", "minLength": 1},
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manufacturer", "subject", "scope", "technology", "checked_at", "source_basis", "scope_note", "event"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "manufacturer": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "scope": {"enum": ["manufacturer_platform", "product_family", "named_product"]},
          "technology": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "checked_at": {"type": "string", "format": "date"},
          "source_document_date": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
          "source_basis": {"enum": ["manufacturer", "official_distributor"]},
          "scope_note": {"type": "string", "minLength": 1},
          "event": {"$ref": "https://github.com/Morshedvarzandeh/battery-data/json-schema/cell-contribution.schema.json#/$defs/lifecycle_event"}
        }
      }
    }
  }
}
