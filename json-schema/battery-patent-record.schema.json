{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lemonergy.com/schemas/battery-patent-record.v1.json",
  "title": "Normalized battery patent candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "taxonomy_version", "publication_number", "authority",
    "document_number", "family_keys", "titles", "abstracts", "classifications",
    "parties", "citations", "source", "rights"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "taxonomy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "publication_number": {"type": "string", "pattern": "^[A-Z]{2}[0-9A-Z./-]+$"},
    "authority": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "document_number": {"type": "string", "minLength": 1},
    "kind_code": {"type": ["string", "null"]},
    "application_number": {"type": ["string", "null"]},
    "pct_number": {"type": ["string", "null"]},
    "filing_date": {"$ref": "#/$defs/dateOrNull"},
    "priority_date": {"$ref": "#/$defs/dateOrNull"},
    "publication_date": {"$ref": "#/$defs/dateOrNull"},
    "grant_date": {"$ref": "#/$defs/dateOrNull"},
    "withdrawn": {"type": ["boolean", "null"]},
    "family_keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "provider", "id"],
        "properties": {
          "kind": {"enum": ["simple", "inpadoc", "national", "artificial"]},
          "provider": {"type": "string", "minLength": 1},
          "id": {"type": "string", "minLength": 1}
        }
      }
    },
    "titles": {"$ref": "#/$defs/localizedTexts"},
    "abstracts": {"$ref": "#/$defs/localizedTexts"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "language", "text_sha256", "redistributable"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "language": {"type": "string", "minLength": 2},
          "text": {"type": ["string", "null"]},
          "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "independent": {"type": ["boolean", "null"]},
          "depends_on": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "redistributable": {"type": "boolean"},
          "locator": {"$ref": "#/$defs/locator"}
        }
      }
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scheme", "code"],
        "properties": {
          "scheme": {"enum": ["IPC", "CPC", "USPC", "FI", "F_TERM", "DEKLA", "other"]},
          "code": {"type": "string", "minLength": 1},
          "version": {"type": ["string", "null"]},
          "inventive": {"type": ["boolean", "null"]},
          "first_position": {"type": ["boolean", "null"]}
        }
      }
    },
    "parties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name"],
        "properties": {
          "role": {"enum": ["inventor", "applicant", "assignee", "owner", "agent", "representative"]},
          "name": {"type": "string", "minLength": 1},
          "country": {"type": ["string", "null"]},
          "sequence": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publication_number"],
        "properties": {
          "publication_number": {"type": "string", "minLength": 1},
          "category": {"type": ["string", "null"]},
          "cited_by": {"type": ["string", "null"]}
        }
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taxon_id", "method", "score", "evidence"],
        "properties": {
          "taxon_id": {"type": "string", "pattern": "^[a-z0-9_]+/[a-z0-9_]+$"},
          "method": {"enum": ["source_asserted", "classification_rule", "keyword_rule", "embedding_model", "llm", "human"]},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "rule_id": {"type": ["string", "null"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "record_id", "retrieved_at", "record_sha256"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "record_id": {"type": "string", "minLength": 1},
        "record_url": {"type": ["string", "null"], "format": "uri"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "source_updated_at": {"type": ["string", "null"], "format": "date-time"},
        "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_license", "fulltext_redistributable"],
      "properties": {
        "metadata_license": {"type": "string", "minLength": 1},
        "metadata_terms_url": {"type": ["string", "null"], "format": "uri"},
        "fulltext_redistributable": {"type": "boolean"},
        "fulltext_license": {"type": ["string", "null"]},
        "fulltext_terms_url": {"type": ["string", "null"], "format": "uri"}
      }
    }
  },
  "$defs": {
    "dateOrNull": {"type": ["string", "null"], "format": "date"},
    "localizedTexts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "text", "machine_translation"],
        "properties": {
          "language": {"type": "string", "minLength": 2},
          "text": {"type": "string", "minLength": 1},
          "machine_translation": {"type": "boolean"}
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["whole_document", "claim", "paragraph", "page", "api_field"]},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "section": {"type": ["string", "null"]},
        "quote": {"type": ["string", "null"]},
        "field_path": {"type": ["string", "null"]}
      }
    }
  }
}
