{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Morshedvarzandeh/battery-data/json-schema/cell-contribution.schema.json",
  "title": "battery-data cell contribution",
  "description": "A community-contributed product specification. Every observation must carry a locator, and any quantity with required conditions must supply them or declare them unstated.",
  "type": "object",
  "required": [
    "schema_version",
    "product",
    "source",
    "observations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "product": {
      "type": "object",
      "required": [
        "uid",
        "kind",
        "manufacturer",
        "model_number"
      ],
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-z_]+/[a-z0-9-]+/[a-z0-9._-]+$"
        },
        "kind": {
          "enum": [
            "cell",
            "module",
            "pack",
            "system",
            "primary_cell",
            "component"
          ]
        },
        "manufacturer": {
          "type": "string"
        },
        "model_number": {
          "type": "string"
        },
        "form_factor": {
          "enum": [
            "cylindrical",
            "pouch",
            "prismatic_hardcase",
            "coin",
            "button",
            "blade",
            "rack",
            "container",
            "brick",
            "other"
          ]
        },
        "form_factor_code": {
          "type": "string"
        },
        "iec_designation": {
          "type": "string"
        },
        "ansi_neda": {
          "type": "string"
        },
        "is_rechargeable": {
          "type": "boolean"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "component_kind": {
          "enum": [
            "dc_dc_converter",
            "on_board_charger",
            "inverter",
            "pcs",
            "contactor",
            "relay",
            "fuse",
            "pyro_fuse",
            "circuit_breaker",
            "bms",
            "battery_disconnect_unit",
            "busbar",
            "cell_contact_system",
            "current_sensor",
            "voltage_sensor",
            "temperature_sensor",
            "pre_charge_resistor",
            "service_disconnect",
            "isolation_monitor",
            "cooling_plate",
            "chiller",
            "heater",
            "thermal_interface_material",
            "vent",
            "enclosure",
            "cell_holder",
            "connector",
            "cable",
            "wire_harness",
            "electrode",
            "separator",
            "electrolyte",
            "other"
          ],
          "description": "Which piece of the hardware around the cell this is. Required when kind is component."
        },
        "lifecycle": {
          "enum": [
            "announced",
            "sampling",
            "active",
            "nrnd",
            "last_time_buy",
            "obsolete",
            "unknown"
          ],
          "description": "Where the product is in its life as the source states it. A maker's page that lists it is evidence of 'active'; an end-of-life notice is evidence of 'obsolete'."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "component"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "component_kind"
            ]
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "uid",
        "kind"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "datasheet",
            "manufacturer_web",
            "standard",
            "journal_article",
            "preprint",
            "dataset",
            "third_party_test",
            "teardown_report",
            "distributor_listing",
            "user_submission"
          ]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "doi": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "document_date": {
          "type": "string",
          "format": "date"
        },
        "is_final": {
          "type": "boolean"
        },
        "license": {
          "type": "string"
        },
        "redistributable": {
          "type": "boolean"
        },
        "region_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hash of the document as retrieved. Identifies the exact revision without storing it."
        },
        "note": {
          "type": "string",
          "description": "Anything qualifying the whole document: licence, a preliminary-status disclaimer, the maker's own caveat about its numbers."
        }
      }
    },
    "chemistry": {
      "type": "object",
      "properties": {
        "designation": {
          "type": "string"
        },
        "cathode_text": {
          "type": "string"
        },
        "anode_text": {
          "type": "string"
        },
        "electrolyte_text": {
          "type": "string"
        },
        "separator_text": {
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "family": {
          "enum": [
            "lithium_ion",
            "lithium_metal",
            "lithium_primary",
            "sodium_ion",
            "sodium_sulfur",
            "sodium_nickel_chloride",
            "lead_acid",
            "nickel_metal_hydride",
            "nickel_cadmium",
            "nickel_zinc",
            "nickel_iron",
            "zinc_air",
            "zinc_carbon",
            "alkaline",
            "silver_oxide",
            "flow_vanadium",
            "flow_zinc_bromine",
            "flow_iron",
            "flow_other",
            "solid_state",
            "supercapacitor",
            "other"
          ],
          "description": "The family a query filters on and an ontology export binds to; designation stays the maker's own string."
        },
        "construction": {
          "enum": [
            "flooded",
            "agm",
            "gel",
            "tubular_plate",
            "flat_plate",
            "bipolar",
            "carbon_enhanced",
            "other"
          ],
          "description": "Lead-acid only: decides charge voltages, orientation, gassing and cycle life more than the chemistry does."
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "curves": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/curve"
      }
    },
    "applications": {
      "type": "array",
      "description": "Where this product is actually fielded. Each entry is a claim about a relationship, so it carries its own basis and locator - see schema/045_application.sql.",
      "items": {
        "$ref": "#/$defs/application"
      }
    },
    "certifications": {
      "type": "array",
      "description": "Certification and listing claims: UN 38.3, IEC 62133, UL 1642, UL 1973, UL 9540A. Scope and status both matter: 'system listed to UL 9540, cells listed to UL 1642' is two rows, and 'pending' is not 'certified'.",
      "items": {
        "$ref": "#/$defs/certification"
      }
    },
    "transport": {
      "$ref": "#/$defs/transport",
      "description": "UN transport classification: the Wh rating that decides PI965 against PI966 depends on the nominal voltage convention, which is itself a stored choice."
    },
    "contains": {
      "type": "array",
      "description": "Bill of materials: the cells, modules and components this product is built from, by uid. Each entry is a claim with its own locator. The child must be in the library for the link to land.",
      "items": {
        "$ref": "#/$defs/contains"
      }
    },
    "equivalences": {
      "type": "array",
      "description": "Drop-in, rebadge, second-source, successor and predecessor relations to other products in the library, each with its evidence.",
      "items": {
        "$ref": "#/$defs/equivalence"
      }
    },
    "offers": {
      "type": "array",
      "description": "Price and availability as a time series: one entry per seller per observation date, never overwritten.",
      "items": {
        "$ref": "#/$defs/offer"
      }
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "required": [
        "quote"
      ],
      "description": "Where in the source this claim comes from. Mandatory - a value with no evidence is rejected.",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string"
        },
        "quote": {
          "type": "string",
          "minLength": 8
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "conditions": {
      "type": "object",
      "description": "condition_set columns. Anything the SOURCE does not state must be named in 'unstated', never silently omitted.",
      "properties": {
        "temperature_c": {
          "type": "number"
        },
        "temperature_reference": {
          "enum": [
            "ambient",
            "chamber_setpoint",
            "cell_surface",
            "can",
            "tab",
            "core",
            "coolant_inlet",
            "coolant_outlet",
            "unspecified"
          ]
        },
        "rate_value": {
          "type": "number"
        },
        "rate_unit": {
          "enum": [
            "A",
            "mA",
            "C",
            "It",
            "W",
            "P",
            "W_per_kg",
            "ohm",
            "pct",
            "unspecified"
          ]
        },
        "rate_reference_capacity_ah": {
          "type": "number"
        },
        "rate_reference_source": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "charge",
            "discharge",
            "rest",
            "symmetric",
            "regen"
          ]
        },
        "voltage_upper_v": {
          "type": "number"
        },
        "voltage_lower_v": {
          "type": "number"
        },
        "soc_pct": {
          "type": "number",
          "minimum": -5,
          "maximum": 105
        },
        "soc_method": {
          "enum": [
            "coulomb_counted",
            "ocv_lookup",
            "bms_reported",
            "voltage_proxy",
            "time_from_full",
            "unspecified"
          ]
        },
        "dod_pct": {
          "type": "number"
        },
        "pulse_duration_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pulse_current_a": {
          "type": "number"
        },
        "frequency_hz": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rest_before_s": {
          "type": "number"
        },
        "cycle_index": {
          "type": "integer"
        },
        "duration_s": {
          "type": "number"
        },
        "constraint_mode": {
          "enum": [
            "unconstrained",
            "constant_force",
            "constant_gap",
            "rigid_case",
            "stack_in_module",
            "unspecified"
          ]
        },
        "clamp_force_n": {
          "type": "number"
        },
        "boundary": {
          "enum": [
            "electrode",
            "cell",
            "module",
            "pack_dc",
            "dc_bus",
            "ac_terminal",
            "ac_including_auxiliaries",
            "unspecified"
          ]
        },
        "load_value": {
          "type": "number"
        },
        "load_unit": {
          "enum": [
            "mA",
            "A",
            "ohm",
            "mW",
            "W"
          ]
        },
        "duty_schedule": {
          "type": "string"
        },
        "cutoff_voltage_v": {
          "type": "number"
        },
        "area_cm2": {
          "type": "number"
        },
        "area_kind": {
          "enum": [
            "separator_total",
            "cathode_single_sided",
            "cathode_double_sided",
            "anode_single_sided",
            "anode_double_sided",
            "geometric_footprint",
            "unspecified"
          ]
        },
        "unstated": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Condition columns the source itself does not state. Recording the omission is required; inferring a value is not permitted."
        },
        "extra": {
          "type": "object"
        },
        "verbatim": {
          "type": "string"
        },
        "circuit_voltage_v": {
          "type": "number",
          "description": "Circuit voltage a breaking, making or endurance rating, or a converter efficiency, was stated at."
        },
        "time_constant_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "L/R time constant of the test circuit for a DC interrupt rating."
        }
      }
    },
    "observation": {
      "type": "object",
      "required": [
        "quantity",
        "value",
        "unit",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "type": "string",
          "description": "Must exist in bd.quantity.code"
        },
        "statistic": {
          "enum": [
            "rated",
            "nominal",
            "standard",
            "minimum",
            "typical",
            "maximum",
            "initial",
            "design",
            "guaranteed",
            "mean",
            "median",
            "measured",
            "absolute_max",
            "absolute_min"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "tol_plus": {
          "type": "number"
        },
        "tol_minus": {
          "type": "number"
        },
        "value_min": {
          "type": "number"
        },
        "value_max": {
          "type": "number"
        },
        "is_lower_bound": {
          "type": "boolean"
        },
        "is_upper_bound": {
          "type": "boolean"
        },
        "n_samples": {
          "type": "integer"
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "application": {
      "type": "object",
      "required": [
        "uid",
        "name",
        "sector",
        "basis",
        "locator"
      ],
      "additionalProperties": false,
      "description": "One fielded use. 'basis' says how the link is known; anything weaker than a statement by the manufacturer or a regulator also needs an explicit 'confidence'.",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^app/[a-z0-9-]+/[a-z0-9._-]+$"
        },
        "name": {
          "type": "string"
        },
        "sector": {
          "enum": [
            "passenger_vehicle",
            "commercial_vehicle",
            "bus",
            "rail",
            "marine",
            "aviation",
            "off_highway",
            "grid_storage",
            "behind_meter_storage",
            "backup_power",
            "industrial",
            "consumer",
            "micromobility",
            "defence",
            "other"
          ]
        },
        "operator": {
          "type": "string",
          "description": "The organisation fielding it, which is rarely the cell maker."
        },
        "programme": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "in_service_from": {
          "type": "string",
          "format": "date"
        },
        "in_service_to": {
          "type": "string",
          "format": "date"
        },
        "system_energy_kwh": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "system_power_kw": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "role": {
          "enum": [
            "traction",
            "propulsion",
            "regenerative",
            "backup",
            "starter",
            "buffer",
            "auxiliary",
            "stationary_storage",
            "other"
          ]
        },
        "quantity_per_unit": {
          "type": "integer",
          "minimum": 1
        },
        "topology_string": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "manufacturer_stated",
            "teardown",
            "regulatory_filing",
            "press_release",
            "trade_press",
            "community_reported",
            "inferred"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "is_exclusive": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "curve": {
      "type": "object",
      "required": [
        "curve_kind",
        "x_quantity",
        "y_quantity",
        "x_unit",
        "y_unit",
        "x_values",
        "y_values",
        "locator"
      ],
      "properties": {
        "curve_kind": {
          "type": "string"
        },
        "x_quantity": {
          "type": "string"
        },
        "y_quantity": {
          "type": "string"
        },
        "x_unit": {
          "type": "string"
        },
        "y_unit": {
          "type": "string"
        },
        "x_values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2
        },
        "y_values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2
        },
        "conditions": {
          "$ref": "#/$defs/conditions"
        },
        "processing": {
          "type": "object"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "certification": {
      "type": "object",
      "required": [
        "standard",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "standard": {
          "type": "string",
          "minLength": 3,
          "description": "Verbatim, e.g. 'IEC 62133-2:2017+AMD1:2021', 'UN 38.3', 'UL 1642'."
        },
        "scope": {
          "enum": [
            "cell",
            "module",
            "rack",
            "pack",
            "system",
            "installation",
            "unspecified"
          ]
        },
        "status": {
          "enum": [
            "claimed",
            "certified",
            "pending",
            "withdrawn"
          ],
          "description": "Default 'claimed': the document says it, nobody here checked a certificate."
        },
        "certificate_number": {
          "type": "string"
        },
        "certifying_body": {
          "type": "string"
        },
        "listing_type": {
          "enum": [
            "listed",
            "recognized_component",
            "tested",
            "self_declared"
          ]
        },
        "issued_date": {
          "type": "string",
          "format": "date"
        },
        "expiry_date": {
          "type": "string",
          "format": "date"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "transport": {
      "type": "object",
      "required": [
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "un_number": {
          "type": "string",
          "pattern": "^UN[0-9]{4}$"
        },
        "hazard_class": {
          "type": "string"
        },
        "packing_instruction": {
          "type": "string",
          "description": "PI965 to PI970 for lithium; PI872 for nickel-metal hydride; UN2794/UN2800 lead-acid carry none."
        },
        "watt_hour_rating": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lithium_content_g": {
          "type": "number",
          "minimum": 0
        },
        "max_soc_for_transport": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "un38_3_summary_url": {
          "type": "string",
          "format": "uri"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "contains": {
      "type": "object",
      "required": [
        "uid",
        "quantity",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-z_]+/[a-z0-9-]+/[a-z0-9._-]+$",
          "description": "The child product's uid, which must exist in the library."
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "series_count": {
          "type": "integer",
          "minimum": 1
        },
        "parallel_count": {
          "type": "integer",
          "minimum": 1
        },
        "topology": {
          "type": "string",
          "description": "'2P52S', '4S3P' as the document writes it."
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "equivalence": {
      "type": "object",
      "required": [
        "uid",
        "relation",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-z_]+/[a-z0-9-]+/[a-z0-9._-]+$"
        },
        "relation": {
          "enum": [
            "drop_in",
            "rebadge",
            "second_source",
            "successor",
            "predecessor"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "offer": {
      "type": "object",
      "required": [
        "seller",
        "observed_at",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "seller": {
          "type": "string"
        },
        "region": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "unit_price": {
          "type": "number",
          "minimum": 0
        },
        "price_per_kwh": {
          "type": "number",
          "minimum": 0
        },
        "min_order_qty": {
          "type": "integer",
          "minimum": 1
        },
        "price_break_qty": {
          "type": "integer",
          "minimum": 1
        },
        "lead_time_days": {
          "type": "integer",
          "minimum": 0
        },
        "in_stock": {
          "type": "boolean"
        },
        "grade": {
          "enum": [
            "A",
            "B",
            "used",
            "recovered",
            "unspecified"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date",
          "description": "The date the listing was read. A price is a time series."
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    }
  }
}
