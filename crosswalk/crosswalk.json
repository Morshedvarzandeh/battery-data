{
  "title": "battery-data standards crosswalk",
  "description": "Mapping between this schema's quantities and the four external vocabularies describing overlapping parts of the battery data landscape. Rows with relation='no_equivalent' record deliberate absences - what a standard cannot express is as important as what it can.",
  "repository": "https://github.com/Morshedvarzandeh/battery-data",
  "license": "CC-BY-4.0",
  "vocabularies": [
    {
      "id": 1,
      "code": "bdf",
      "name": "Battery Data Format",
      "namespace": "https://w3id.org/battery-data-alliance/ontology/battery-data-format#",
      "version": "1.2.0",
      "url": "https://github.com/battery-data-alliance/battery-data-format",
      "license": "Apache-2.0",
      "notes": "Published Dec 2025 by the LF Energy Battery Data Alliance. Adopted verbatim for bd.timeseries_record column names. A parallel METADATA format has been announced but does not yet exist - that is the layer bd.product_revision, bd.condition_set and bd.protocol occupy."
    },
    {
      "id": 2,
      "code": "emmo_battery",
      "name": "EMMO domain-battery",
      "namespace": "https://w3id.org/emmo/domain/battery#",
      "version": "0.20.0",
      "url": "https://github.com/emmo-repo/domain-battery",
      "license": "CC-BY-4.0",
      "notes": "Annotated \"unstable\". Class IRIs are opaque UUIDs; human labels live in skos:prefLabel. Adoption outside EU projects is thin. Treat as the vocabulary of record, not a working data format."
    },
    {
      "id": 3,
      "code": "emmo_electrochemistry",
      "name": "EMMO domain-electrochemistry",
      "namespace": "https://w3id.org/emmo/domain/electrochemistry#",
      "version": "0.34.0",
      "url": "https://github.com/emmo-repo/domain-electrochemistry",
      "license": "CC-BY-4.0",
      "notes": "Carries the quantities and materials terms (~3000)."
    },
    {
      "id": 4,
      "code": "bpx",
      "name": "Battery Parameter eXchange",
      "namespace": null,
      "version": "0.4",
      "url": "https://github.com/FaradayInstitution/BPX",
      "license": "Apache-2.0",
      "notes": "Physics models only - DFN/SPM/SPMe. No ECM schema and no published roadmap for one; bd.ecm_parameter_point fills that gap."
    },
    {
      "id": 5,
      "code": "battery_pass",
      "name": "Battery Passport Data Model",
      "namespace": "https://github.com/batterypass/BatteryPassDataModel",
      "version": "1.2.0",
      "url": "https://github.com/batterypass/BatteryPassDataModel",
      "license": "MIT",
      "notes": "Aligned to DIN DKE SPEC 99100:2025-02. Mandatory under EU Reg 2023/1542 Art. 77 + Annex XIII from 18 Feb 2027."
    },
    {
      "id": 6,
      "code": "optimade",
      "name": "OPTIMADE",
      "namespace": "https://optimade.org/",
      "version": "1.3.0",
      "url": "https://www.optimade.org/",
      "license": "CC-BY-4.0",
      "notes": "API conventions worth copying; entry types are crystal-structure-shaped and should not be extended to cells. Federate materials by ID."
    }
  ],
